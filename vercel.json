{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/obfuscationvx=:token",
      "destination": "/obfuscation.html?vx=:token"
    },
    {
      "source": "/get/raw/:id/:code",
      "destination": "/api/payload?rid=:id&rcode=:code"
    },
    {
      "source": "/get/raw/:id/:code/:hop",
      "destination": "/api/payload?rid=:id&rcode=:code&rhop=:hop"
    }
  ],
  "crons": [
    {
      "path": "/api/discord-leaderboard-refresh",
      "schedule": "0 0 * * *"
    }
  ]
}
